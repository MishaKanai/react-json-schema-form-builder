{
  "name": "react-json-schema-form-builder",
  "version": "4.0.0",
  "description": "React Component for visually configuring a JSON Schema-based form",
  "author": {
    "name": "Nathan Alam",
    "email": "nathanalam99@gmail.com",
    "url": "https://github.com/nathanalam"
  },
  "license": "Apache-2.0",
  "repository": "MishaKanai/react-json-schema-form-builder",
  "keywords": [
    "react",
    "form",
    "json-schema",
    "visual"
  ],
  "main": "lib/index.js",
  "module": "lib-esm/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib": {
      "types": "./lib/index.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib/*.js",
      "default": "./lib/*.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib/*.js",
      "default": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf node_modules coverage dist",
    "build": "npm run build:cjs && npm run build:esm",
    "prepublishOnly": "npm run build",
    "start": "tsc --watch --outDir lib",
    "test": "run-s test:unit",
    "test:unit": "jest --env=jsdom --coverage --coverageDirectory=coverage/",
    "test:watch": "jest --watch --env=jsdom",
    "build:cjs": "tsc --outDir lib",
    "build:esm": "tsc --outDir lib-esm --module esnext --moduleResolution node --declaration false && node scripts/finalizeEsmBuild.cjs"
  },
  "peerDependencies": {
    "@mui/material": "^7.0.0",
    "@mui/icons-material": "^7.0.0",
    "react": "^17.0.0 || ^18.0.0"
  },
  "files": [
    "/lib",
    "/lib-esm",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@types/jest": "^27.4.7",
    "@types/react": "^17.0.69",
    "@types/react-dom": "^17.0.21",
    "@wojtekmaj/enzyme-adapter-react-17": "^0.8.0",
    "coveralls": "^3.1.0",
    "enzyme": "^3.11.0",
    "jest": "^27.4.7",
    "npm-run-all": "^4.1.5",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "rimraf": "^3.0.2",
    "ts-jest": "^27.1.5",
    "ts-loader": "^9.3.1",
    "typescript": "^4.7.4"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "react-beautiful-dnd": "^13.0.0"
  },
  "resolutions": {
    "@types/react": "^17.0.69"
  },
  "bugs": {
    "url": "https://github.com/ginkgobioworks/react-json-schema-form-builder/issues",
    "email": "devs@ginkgobioworks.com"
  }
}
